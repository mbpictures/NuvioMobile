<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  DLNA device discovery only works after applying to apple here (https://developer.apple.com/contact/request/networking-multicast).
	  Sideloading should work without it.
	-->
	<key>com.apple.developer.networking.multicast</key>
	<true/>
</dict>
</plist>
